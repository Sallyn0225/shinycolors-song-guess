# cp .env.example .env 后填写。.env 不入库。

# ── 两种部署形态，先确认你是哪一种 ─────────────────────
#
# 1. 裸机，80/443 空着：
#      docker compose --profile caddy up -d
#    需要下面的 DOMAIN 与 ACME_EMAIL。
#
# 2. 机器上已有系统级反代（nginx / 系统 Caddy / 面板的 OpenResty）：
#      docker compose up -d
#    **不要**启用 caddy profile，否则抢不到端口。
#    改为把 127.0.0.1:${APP_PORT} 挂到现有反代上，
#    配置片段见 Caddyfile 顶部的注释。这种形态下 DOMAIN 用不上。

# 容器发布到宿主机回环的端口。和现有服务撞了就改这个
APP_PORT=5179

# 仅 caddy profile 需要。境内 VPS 的域名必须**已备案**，否则 80/443 会被拦
DOMAIN=

# 仅 caddy profile 需要。留空也能签发证书，只是收不到到期提醒
ACME_EMAIL=

# 镜像。默认拉 GHCR 上由 Actions 构建好的那个。
# 想跑本地构建的产物就改成任意本地 tag，再 `docker compose build`。
# APP_IMAGE=ghcr.io/sallyn0225/shinycolors-song-guess:latest

# ── 以下都有合理默认值，只在需要时取消注释 ──────────────
# 详见 DEPLOY.md 的「环境变量」与「房间配额」两节。

# 全局同时存在的房间数上限。设成 0 即临时关停建房，不用改代码
# MAX_ROOMS=200

# 单 IP 同时持有的房间数。**会误伤 NAT 后面的人**——同一个宿舍/办公室
# 出口的所有玩家共享一个公网 IP。玩家集中在同一出口就调大
# MAX_ROOMS_PER_IP=5

# 单 IP 每分钟建房次数
# CREATE_PER_MIN=15

# 单 IP 每分钟加入失败次数。这是私人房间不被枚举的实际保障
# JOIN_FAIL_PER_MIN=20

# 封面/缩略图的 CDN 前缀。**切片绝不能走 CDN**，见 DEPLOY.md
# PUBLIC_ASSET_BASE=
