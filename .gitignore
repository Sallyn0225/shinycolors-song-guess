# 素材（源音源，1.7GB，不入库）
songs/

# 构建产物（切片 ~200MB + 封面 ~15MB，不入库）
assets/

# Node
node_modules/
dist/
*.tsbuildinfo
.DS_Store
.vite/
coverage/

# 调试产物：浏览器自动化的输出和随手截的图
.playwright-mcp/
/*.png

# 设计风格提取产物（designlang 自动生成 ~16MB，含官网截图与原始 CSS，均为第三方版权素材）
# 只保留人工校订后的设计语言文档
design-extract-output/*
!design-extract-output/SHINYCOLORS-DESIGN-LANGUAGE.md

# Trellis：只保留 tasks / spec / workspace，其余（脚本、模板、运行时状态）不入库
.trellis/*
!.trellis/tasks/
!.trellis/spec/
!.trellis/workspace/
!.trellis/.gitignore

# AI agent 工具目录
.agents/
.claude/
.pi/
.cursor/
.codex/
.gemini/
.windsurf/
.continue/
.roo/
.cline/
.aider*
.specstory/
CLAUDE.local.md
AGENTS.local.md
# 外部 skill 的锁文件，与 .claude/skills/ 配套，跟着 .claude/ 一起不入库
skills-lock.json
